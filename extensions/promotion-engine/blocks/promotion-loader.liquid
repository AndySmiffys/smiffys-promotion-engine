<script src="{{ 'promotion-ui.js' | asset_url }}" defer></script>
<script src="{{ 'promotion-placements.js' | asset_url }}" defer></script>
<promotion-engine-embed
  hidden
  data-badges-enabled="{{ block.settings.badges_enabled }}"
  data-card-selector="{{ block.settings.card_selector | escape }}"
  data-badge-selector="{{ block.settings.badge_selector | escape }}"
  data-badge-position="{{ block.settings.badge_position }}"
  data-proxy-path="/apps/promotion-engine"
  data-root="{{ routes.root_url | escape }}"
  data-collection-id="{{ collection.id }}"
></promotion-engine-embed>
{% schema %}
{
  "name":"Promotion Engine loader",
  "target":"body",
  "javascript":"promotion-engine.js",
  "settings":[
    {"type":"paragraph","content":"Automatically places product card badges. Add Header promotion for announcements, Product promotion to product details, and Collection promotion above the collection grid."},
    {"type":"checkbox","id":"badges_enabled","label":"Show product card badges","default":true},
    {"type":"select","id":"badge_position","label":"Badge position","default":"top-left","options":[{"value":"top-left","label":"Top left"},{"value":"top-right","label":"Top right"},{"value":"bottom-left","label":"Bottom left"},{"value":"bottom-right","label":"Bottom right"}]},
    {"type":"header","content":"Advanced theme placement"},
    {"type":"paragraph","content":"Leave selectors blank for automatic Dawn and Horizon badge placement. Other themes may need selectors from your theme developer. Move badges if they overlap theme sale or sold-out labels."},
    {"type":"text","id":"card_selector","label":"Product card CSS selector"},
    {"type":"text","id":"badge_selector","label":"Badge container CSS selector"}
  ]
}
{% endschema %}
